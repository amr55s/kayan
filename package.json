{
  "name": "kayanhub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "check:env": "node scripts/check-env.mjs --contract",
    "check:env:deployment": "node scripts/check-env.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:e2e:preview": "playwright test",
    "smoke:spaces": "node scripts/smoke-do-spaces-prefix.mjs",
    "verify": "npm run check:env && npm run check:migrations && npm run lint && npm run typecheck && npm test && npm audit --omit=dev --audit-level=high",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "media:backfill:dry-run": "node scripts/backfill-legacy-media.mjs",
    "media:backfill:apply": "node scripts/backfill-legacy-media.mjs --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/s3-request-presigner": "3.1106.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@heroui/react": "^3.2.3",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "exceljs": "4.4.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "^16.2.12",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "web-push": "3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "libpg-query": "17.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.24",
    "sharp": "$sharp"
  }
}
