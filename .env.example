NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required for the admin provisioning actions; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public browser key used to create Push subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Server-only key used by the scheduled notification worker/Edge Function.
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:ops@example.com
