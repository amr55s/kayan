NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SITE_URL=https://kayan-hazel.vercel.app
# Preferred public browser key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Temporary compatibility fallback while the legacy key is being retired.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Preferred server-only key. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-key
# Temporary compatibility fallback while the legacy key is being retired.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only salt used when hashing anonymous error-report rate-limit keys.
CLIENT_ERROR_HASH_SALT=replace-with-a-long-random-secret
# Public browser key used to create Push subscriptions.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Server-only key used by the scheduled notification worker/Edge Function.
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:ops@example.com
